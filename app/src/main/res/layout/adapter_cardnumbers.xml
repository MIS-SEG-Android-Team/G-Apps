<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ToggleButton
        android:id="@+id/mtv_num1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="25dp"
        android:background="@color/white"
        android:textColor="@color/guanzon_digital_orange"
        android:textSize="18dp"
        android:checked="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.190"/>

    <ToggleButton
        android:id="@+id/mtv_num2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="25dp"
        android:background="@color/white"
        android:textColor="@color/guanzon_digital_orange"
        android:textSize="18dp"
        android:layout_marginStart="5dp"
        android:checked="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/mtv_num1"
        app:layout_constraintWidth_percent="0.190"
        app:layout_constraintHeight_percent="0.90"/>

    <ToggleButton
        android:id="@+id/mtv_num3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="25dp"
        android:background="@color/white"
        android:textColor="@color/guanzon_digital_orange"
        android:textSize="18dp"
        android:layout_marginStart="5dp"
        android:checked="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/mtv_num2"
        app:layout_constraintWidth_percent="0.190"
        app:layout_constraintHeight_percent="0.90"/>

    <ToggleButton
        android:id="@+id/mtv_num4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="25dp"
        android:background="@color/white"
        android:textColor="@color/guanzon_digital_orange"
        android:textSize="18dp"
        android:layout_marginStart="5dp"
        android:checked="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/mtv_num3"
        app:layout_constraintWidth_percent="0.190"
        app:layout_constraintHeight_percent="0.90"/>

    <ToggleButton
        android:id="@+id/mtv_num5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="25dp"
        android:background="@color/white"
        android:textColor="@color/guanzon_digital_orange"
        android:textSize="18dp"
        android:layout_marginStart="5dp"
        android:checked="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/mtv_num4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.190"
        app:layout_constraintHeight_percent="0.90"/>

</androidx.constraintlayout.widget.ConstraintLayout>