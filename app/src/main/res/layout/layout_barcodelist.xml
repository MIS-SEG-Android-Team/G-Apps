<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="5dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/gradient_orange_dark"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mcv_index"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        app:cardCornerRadius="25dp"
        app:cardBackgroundColor="@color/guanzon_digital_orange"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/circle_background"
            android:layout_margin="1dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtv_index"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="?attr/colorPrimary"
                android:paddingVertical="10dp"
                android:paddingHorizontal="17dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/mtv_barcode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="431029453"
        android:letterSpacing="0.5"
        android:gravity="center_vertical"
        android:layout_marginStart="10dp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/mcv_index"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintWidth_percent="0.7"/>
    
    <ImageButton
        android:id="@+id/btn_imgdelete"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/baseline_delete_24"
        android:background="@color/zxing_transparent"
        app:layout_constraintStart_toEndOf="@+id/mtv_barcode"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mtv_barcode"
        app:layout_constraintBottom_toBottomOf="@+id/mtv_barcode"
        app:layout_constraintWidth_percent="0.1"/>

</androidx.constraintlayout.widget.ConstraintLayout>