<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.7"
        app:layout_constraintWidth_percent="0.9">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img_candidate"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:src="@drawable/kay"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintHeight_percent="0.7"
                app:layout_constraintWidth_percent="0.9" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/Title"
                android:id="@+id/mtv_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Contestant Name"
                android:textColor="?attr/colorPrimary"
                app:layout_constraintStart_toStartOf="@+id/img_candidate"
                app:layout_constraintTop_toBottomOf="@+id/img_candidate"
                app:layout_constraintWidth_percent="0.5" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtv_school"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Campus Name"
                app:layout_constraintStart_toStartOf="@+id/mtv_name"
                app:layout_constraintEnd_toEndOf="@+id/mtv_name"
                app:layout_constraintTop_toBottomOf="@+id/mtv_name" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/Title"
                android:id="@+id/mtv_number"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="0"
                android:gravity="center"
                app:layout_constraintTop_toTopOf="@+id/mtv_name"
                app:layout_constraintBottom_toBottomOf="@+id/mtv_school"
                app:layout_constraintStart_toEndOf="@+id/mtv_name"
                app:layout_constraintEnd_toEndOf="@+id/img_candidate"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:paddingVertical="10dp"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@+id/mtv_school"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@+id/img_candidate"
                app:layout_constraintEnd_toEndOf="@+id/img_candidate">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_vote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vote Now"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cancel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Close"/>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>